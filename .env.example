# Environment Variables Example for Geo-Verified Facial Recognition Attendance System
# Copy this file to .env and adjust variables as needed.

# Face Recognition Settings
# Euclidean distance threshold (lower = stricter, 0.50-0.60 is recommended for dlib ResNet)
MATCH_THRESHOLD=0.55
# Secondary threshold: matches between REVIEW_THRESHOLD and MATCH_THRESHOLD are marked as 'flagged' for admin review
REVIEW_THRESHOLD=0.62
# Duplicate check cooldown in seconds (e.g., 300 = 5 minutes)
DUPLICATE_COOLDOWN_SECONDS=300

# Geolocation Settings
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=optional_if_using_paid_provider
NOMINATIM_USER_AGENT=GeoFaceAttendanceSystem/2.0

# Flask & Security Settings
FLASK_SECRET_KEY=college_project_geoface_secret_key_2026_xyz
FLASK_DEBUG=True
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database Settings
DATABASE_URL=sqlite:///attendance.db
